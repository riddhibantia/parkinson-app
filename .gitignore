parkinson_app/functions/data/tappy_dataset/keystrokes/
parkinson_app/functions/data/tappy_dataset/users/
parkinson_app/functions/data/neuroqwerty_dataset/*.zip
parkinson_app/functions/data/neuroqwerty_dataset/nq/

# Trained model binaries — regenerable via functions/models/run_*.py
